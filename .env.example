# ==============================================================================
# AIEM Hunt — Environment Configuration Template
# Agnel Institute of Engineering and Management, Assagao, Goa
# ==============================================================================

# Database Configuration
# Local Development: Standard standalone or single-node replica set
# Production / Staging: Transaction-capable replica set cluster (e.g. mongodb://.../?replicaSet=rs0)
MONGODB_URI="mongodb://127.0.0.1:27017/aiem_hunt"

# Application URLs
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Security & Authentication Secrets
# CRITICAL: Must be a random, cryptographically secure string (min. 32 characters) in staging/production
JWT_SECRET="aiem_hunt_super_secret_session_signing_key_min_32_chars_2026"

# Database Safety Guard & Seed Credentials
# Destructive seeding is disabled by default. Set to "true" only in isolated test/dev environments.
ALLOW_DESTRUCTIVE_SEED="false"
# Seed credentials MUST be supplied via environment variables when running seed scripts (no hardcoded fallbacks):
# DEFAULT_ADMIN_PASSWORD="YourSecureAdminPassword2026!"
# DEFAULT_MOD_PASSWORD="YourSecureModPassword2026!"
# DEFAULT_HUNTER_PASSWORD="YourSecureHunterPassword2026!"

# Institutional SMTP Mailer Configuration
# In local development, verification OTPs print directly to the server terminal.
# Configure live institutional SMTP credentials for production email delivery:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="admin@aiemgoa.ac.in"
# SMTP_PASS="your-institutional-app-password"
# SMTP_FROM="AIEM Hunt Security <security@aiemgoa.ac.in>"