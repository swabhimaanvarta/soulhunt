# ==============================================================================
# AIEM Hunt — Production & Staging Environment Configuration Template
# Agnel Institute of Engineering and Management, Assagao, Goa
# ==============================================================================

# Database Configuration (Professional / Managed Cloud Database)
# Production / Staging (MongoDB Atlas, Railway, AWS DocumentDB):
# MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/aiem_hunt?retryWrites=true&w=majority&appName=AIEMHunt"
# Set ALLOW_REMOTE_DB="true" when connecting to remote cloud MongoDB in non-production environments
ALLOW_REMOTE_DB="false"
# Local Development: Standard loopback standalone or replica set
MONGODB_URI="mongodb://127.0.0.1:27017/aiem_hunt"

# Application URLs (Set to your production domain on Vercel / Cloud)
# Example: https://aiem-hunt.vercel.app or https://hunt.aiemgoa.ac.in
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Security & Authentication Secrets
# CRITICAL: Must be a random, cryptographically secure string (min. 32 characters) in production
# Generate using: openssl rand -base64 32
JWT_SECRET="aiem_hunt_super_secret_session_signing_key_min_32_chars_2026"
# Secret for HMAC clue personalization and variant seed generation
VARIANT_SECRET="aiem_hunt_variant_cryptographic_seed_secret_2026"

# Database Safety Guard & Seed Credentials
# Destructive seeding is disabled by default. Set to "true" only in isolated test/dev environments.
ALLOW_DESTRUCTIVE_SEED="false"
# Seed credentials MUST be supplied via environment variables when running seed scripts:
# DEFAULT_ADMIN_PASSWORD="YourSecureAdminPassword2026!"
# DEFAULT_MOD_PASSWORD="YourSecureModPassword2026!"
# DEFAULT_HUNTER_PASSWORD="YourSecureHunterPassword2026!"

# Institutional SMTP Mailer Configuration
# In local development, verification OTPs print directly to the server terminal.
# Configure live institutional SMTP credentials for production email delivery:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="admin@aiemgoa.ac.in"
# SMTP_PASS="your-institutional-app-password"
# SMTP_FROM="AIEM Hunt Security <security@aiemgoa.ac.in>"

# AI Quest & Game Master Configuration
# AIEM Hunt features a multi-tiered Game Master:
# 1) Google Gemini (Free tier via Google AI Studio)
# 2) OpenAI (GPT-4o mini)
# 3) Deterministic Course-Aligned Syllabus Engine (Zero-dependency local fallback)
# Primary provider selection: "AUTO" (prefers Gemini if key provided, then OpenAI, then template), "GEMINI", or "OPENAI"
AI_PRIMARY_PROVIDER="AUTO"

# Google Gemini API Key (Get free key at https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-1.5-flash"

# OpenAI API Key (https://platform.openai.com/api-keys)
# OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL="gpt-4o-mini"

# Staged Rollout Feature Flags
# Set to "false" to disable individual subsystems during maintenance or phased rollouts
SQUAD_CHAT_ENABLED="true"
SQUAD_ROLE_V2_ENABLED="true"
VIRTUAL_SHOP_ENABLED="true"
NEW_MAP_ENABLED="true"
